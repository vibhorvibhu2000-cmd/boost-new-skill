{
  "name": "boost-new-skill",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Boost New Skill - Hindi + English online learning platform",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:artifacts": "playwright test && node organize-artifacts.mjs",
    "evidence": "playwright test && node organize-artifacts.mjs && node generate-test-reports.mjs && node evidence-mp4.mjs",
    "evidence:organize": "node organize-artifacts.mjs",
    "evidence:report": "node generate-test-reports.mjs",
    "evidence:mp4": "node evidence-mp4.mjs",
    "screenshot": "playwright test tests/RFT-029-screenshots.spec.js",
    "deploy": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.64.1",
    "vite": "^6.0.5"
  },
  "allowScripts": {
    "@firebase/util@1.12.1": true,
    "esbuild@0.25.12": true
  }
}
